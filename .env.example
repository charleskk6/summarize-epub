# Copy to .env, then uncomment ONE provider block and replace its API key.
# The base URL must stop before /chat/completions. No code edits required.

# OpenAI
# LLM_API_KEY=replace-with-your-openai-key
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-5

# Anthropic OpenAI-compatible endpoint (use a workspace-scoped API key)
# LLM_API_KEY=replace-with-your-anthropic-key
# LLM_BASE_URL=https://api.anthropic.com/v1
# LLM_MODEL=claude-sonnet-4-6

# Google Gemini OpenAI-compatible endpoint
# LLM_API_KEY=replace-with-your-gemini-key
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-2.5-flash

# DeepSeek OpenAI-compatible endpoint
# LLM_API_KEY=replace-with-your-deepseek-key
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-flash

# Leave blank to inherit LLM_MODEL; same endpoint/API key are used for vision.
# LLM_VISION_MODEL=
LLM_MAX_TOKENS=8192
LLM_TEMPERATURE=0.3
LLM_TIMEOUT=180
LLM_CONCURRENCY=4

# USD per 1M tokens. Zero means unpriced, not a claim that calls are free.
LLM_INPUT_PRICE=0
LLM_OUTPUT_PRICE=0
